# ── GitHub ──────────────────────────────────────────────────────────────────
GITHUB_TOKEN=ghp_your_token_here
GITHUB_WEBHOOK_SECRET=your_webhook_secret_here

# ── OpenAI ──────────────────────────────────────────────────────────────────
OPENAI_API_KEY=sk-your_openai_key_here

# ── AWS / SQS ───────────────────────────────────────────────────────────────
SQS_QUEUE_URL=https://sqs.us-east-1.amazonaws.com/123456789012/pr-review-queue

# ── Tuning ──────────────────────────────────────────────────────────────────
MAX_FILES_PER_PR=10
MAX_DIFF_CHARS=8000
LARGE_PR_THRESHOLD=15
SKIP_EXTENSIONS=.lock,.svg,.png,.jpg,.jpeg,.gif,.json,.csv,.md,.txt,.yaml,.yml

# ── Dev only ─────────────────────────────────────────────────────────────────
# Set to true to expose /docs in local dev; always false in production
ENABLE_DOCS=true
APP_VERSION=1.0.0
