# ═══════════════════════════════════════════════════════════════════════════════
# PR Review Agent — Environment Configuration
# ═══════════════════════════════════════════════════════════════════════════════
# Copy this file to `.env` and fill in your values.
# NEVER commit the real .env file — it contains secrets.
# ═══════════════════════════════════════════════════════════════════════════════

# ── GitHub ──────────────────────────────────────────────────────────────────
# Personal Access Token with `repo` and `pull_requests` scopes.
GITHUB_TOKEN=ghp_your_github_token_here

# Shared secret configured in the GitHub webhook settings.
GITHUB_WEBHOOK_SECRET=your_webhook_secret_here

# ── OpenAI ──────────────────────────────────────────────────────────────────
# API key for GPT-4o access.
OPENAI_API_KEY=sk-your_openai_api_key_here

# Model to use for code review (default: gpt-4o).
# OPENAI_MODEL=gpt-4o

# ── AWS / SQS ───────────────────────────────────────────────────────────────
# SQS queue URL for large PR async processing.
SQS_QUEUE_URL=https://sqs.us-east-1.amazonaws.com/123456789012/pr-review-queue

# (Lambda only) Name of the Secrets Manager secret containing credentials.
# PR_REVIEW_SECRET_NAME=pr-review-agent/secrets

# ── Tuning ──────────────────────────────────────────────────────────────────
# Maximum number of files to review per PR (default: 10).
MAX_FILES_PER_PR=10

# Maximum characters of diff to send per file (default: 8000).
MAX_DIFF_CHARS=8000

# Optional total token budget across all reviewed files (0 disables budget filtering).
MAX_TOTAL_TOKENS=0

# PRs with more changed files than this are routed to SQS (default: 15).
LARGE_PR_THRESHOLD=15

# Comma-separated file extensions to skip during review.
SKIP_EXTENSIONS=.lock,.svg,.png,.jpg,.jpeg,.gif,.json,.csv,.md,.txt,.yaml,.yml

# ── Dev only ─────────────────────────────────────────────────────────────────
# Set to true to expose /docs and /redoc Swagger UI (always false in production).
ENABLE_DOCS=true

# Application version string.
APP_VERSION=1.0.0
